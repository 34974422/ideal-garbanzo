-- Function to dynamically generate a custom spinning coin
local function spawnCustomCoin(position)
	-- Create the physical coin part
	local coin = Instance.new("Part")
	coin.Size = Vector3.new(3, 3, 0.5)
	coin.Shape = Enum.PartType.Cylinder
	coin.Color = Color3.fromRGB(255, 215, 0) -- Gold color
	coin.Material = Enum.Material.Neon
	coin.Position = position + Vector3.new(0, 2, 0) -- Lift slightly off ground
	coin.Anchored = true
	coin.CanCollide = false
	coin.Parent = workspace

	-- Create an infinite spinning animation loop
	task.spawn(function()
		while coin and coin.Parent do
			coin.Orientation = coin.Orientation + Vector3.new(0, 4, 0)
			task.wait(0.02)
		end
	end)

	-- Debounce variable to prevent double-touch glitching
	local beingCollected = false

	-- Trigger collection when a player touches the coin
	coin.Touched:Connect(function(otherPart)
		if beingCollected then return end

		local character = otherPart.Parent
		local player = Players:GetPlayerFromCharacter(character)

		if player then
			beingCollected = true
			
			-- Award the custom amount of coins
			player.leaderstats.Coins.Value = player.leaderstats.Coins.Value + 10
			
			-- Play a nice collection animation (fades out and shrinks)
			local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			local goal = {
				Size = Vector3.new(0,0,0),
				Transparency = 1
			}
			local tween = TweenService:Create(coin, tweenInfo, goal)
			tween:Play()
			
			-- Completely delete the coin part from memory once animation finishes
			tween.Completed:Connect(function()
				coin:Destroy()
			end)
		end
	end)
end

-- Automatically spawn 5 sample coins across your map center when the game starts
task.wait(2) -- Wait for world to load
