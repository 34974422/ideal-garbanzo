 -- Save this script inside "ServerScriptService" in Roblox Studio
-- Name the script: GameManager

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local TweenService = game:GetService("TweenService")

-- Create a secure database to save player coins
local coinDataStore = DataStoreService:GetDataStore("PlayerCoins_v1")

---------------------------------------------------------
-- 1. LEADERBOARD & DATA SAVING SYSTEM
---------------------------------------------------------

-- Triggers when a new player joins the game
local function onPlayerAdded(player)
	-- Create the top-right leaderboard
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	-- Add "Coins" stat to the leaderboard
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Value = 0 -- Default value
	coins.Parent = leaderstats

	-- Load saved data from GitHub/Roblox secure cloud
	local playerKey = "Player_" .. player.UserId
	local success, savedCoins = pcall(function()
		return coinDataStore:GetAsync(playerKey)
	end)

	if success and savedCoins then
		coins.Value = savedCoins
		print("Successfully loaded " .. savedCoins .. " coins for " .. player.Name)
	else
		print("No saved data found for " .. player.Name .. ". Starting fresh!")
	end
end

-- Triggers when a player leaves the game
local function onPlayerRemoving(player)
	local playerKey = "Player_" .. player.UserId
	local coinsValue = player.leaderstats.Coins.Value

	-- Save data to the cloud
	local success, err = pcall(function()
		coinDataStore:SetAsync(playerKey, coinsValue)
	end)

	if success then
		print("Successfully saved data for " .. player.Name)
	else
		warn("Failed to save data for " .. player.Name .. ": " .. tostring(err))
	end
end

-- Connect functions to player events
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)


